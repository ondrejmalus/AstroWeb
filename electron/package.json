{
  "name": "astroweb-admin",
  "version": "1.0.0",
  "description": "AstroWeb Admin Desktop Application",
  "author": "Ondřej Malůš",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "cz.astroweb.admin",
    "productName": "AstroWeb Admin",
    "files": [
      "frontend-admin/**/*",
      "main.cjs",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }

}
